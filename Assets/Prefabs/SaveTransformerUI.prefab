  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Y Offset adjusts the vertical position of your structures. In the
    old system, terrain surface was around Y=0, but in the new system, Y=0 is bedrock,
    so lifting is recommened.



    The X & Z Offsets move all stuctures horizontally.
    Use this to find a nice spot for your structures.



    The transformation uses
    offsets. This means, the specified coordinates get added to the previous corrdinates.
    If you built around spawn in the old system, using the offsets with corrdinates
    from the GPS tablet works great, but if you built your base far far away from
    spawn, you might have to calculate what the offsets should be.


    DO NOT use
    the Load Save button while already ingame, the game cannot handle that!

    The
    offsets move your base, they do not reposition it!

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8b5b5a6f27755684da5d50ffb6416df5, type: 2}
